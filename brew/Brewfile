# Brewfile — macOS package manifest for dotfiles-latest
# Applied by scripts/macos/mac/bootstrap.sh via: brew bundle --file=brew/Brewfile
#
# This mirrors the pacman list in scripts/linux/arch/bootstrap.sh, adapted to
# Homebrew. Linux-only entries (base-devel, gcc/clang/lldb, wl-clipboard,
# xclip, openssh, noto-fonts, ttf-*) are dropped: on macOS the compiler
# toolchain comes from the Xcode Command Line Tools, and Nerd Fonts are
# installed as casks below.

